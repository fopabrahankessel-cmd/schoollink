# Copy to .env on the server (cp .env.example .env) and fill in every value. .env is never committed.
# docs/DEPLOYMENT.md explains each one.

# The address of SchoolLink, without https:// (its DNS A record points to this server)
SCHOOLLINK_DOMAIN=schoollink.example.org

# Database password: a long random value, e.g. from  openssl rand -hex 24
DB_PASSWORD=

# Signs the sign-in tokens: 32+ random bytes, e.g. from  openssl rand -base64 48
JWT_SECRET=

# Twilio (SMS): from the Twilio console. TWILIO_FROM is the approved sender ID, e.g. SchoolLink
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# First start of each school only (see the guide), then empty these lines again
BOOTSTRAP_SCHOOL_NAME=
BOOTSTRAP_SCHOOL_LANGUAGE=FR
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
