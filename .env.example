# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Local development values only.
DB_NAME=schoollink
DB_USER=schoollink
DB_PASSWORD=schoollink
DB_PORT=5433

# Backend: secret that signs access tokens (32+ bytes). Generate one for any shared environment.
# JWT_SECRET=

# Backend: regex of proxy addresses whose X-Forwarded-For is trusted (default: loopback only).
# TRUSTED_PROXIES=

# Backend: path of the Firebase service-account JSON file, for push notifications (BR-21).
# Keep the file outside the repository. Unset in dev: pushes are logged, not sent.
# FIREBASE_CREDENTIALS=

# Backend: the Twilio account for SMS (BR-22 to BR-24). Unset in dev: SMS are logged, not sent.
# TWILIO_FROM is the sender (a number, or an approved alphanumeric sender ID). SMS_STATUS_CALLBACK_URL
# is the public URL of the delivery webhook, e.g. https://api.example.org/api/v1/webhooks/sms/delivery
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_STATUS_CALLBACK_URL=
