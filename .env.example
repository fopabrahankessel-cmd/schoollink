# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Local development values only.
DB_NAME=schoollink
DB_USER=schoollink
DB_PASSWORD=schoollink
DB_PORT=5433

# Backend: secret that signs access tokens (32+ bytes). Generate one for any shared environment.
# JWT_SECRET=

# Backend: regex of proxy addresses whose X-Forwarded-For is trusted (default: loopback only).
# TRUSTED_PROXIES=
